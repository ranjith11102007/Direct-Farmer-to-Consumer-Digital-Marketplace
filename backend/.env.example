# Vaikkal backend configuration
# Copy to .env and adjust values for your environment.

# ---- App ----
APP_NAME=Vaikkal Platform
ENVIRONMENT=development
DEBUG=true

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://vaikkal:vaikkal@localhost:5432/vaikkal
DATABASE_ECHO=false

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth / Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-please-use-a-secure-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
PASSWORD_MIN_LENGTH=8

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=10

# ---- Payments ----
PAYMENT_PROVIDER=mock
PLATFORM_FEE_PERCENT=3.0
DELIVERY_CHARGE_FLAT=35.0
PACKAGING_CHARGE_PERCENT=1.5
MIN_ORDER_VALUE_FREE_DELIVERY=499

# ---- Notifications ----
SMS_PROVIDER=mock
EMAIL_PROVIDER=console
WHATSAPP_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@vaikkal.in
SMTP_FROM_NAME=Vaikkal

# ---- URLs ----
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# ---- AI / ML ----
FORECAST_MODEL_VERSION=v1.0.0
FORECAST_DEFAULT_LOOKBACK_DAYS=90
MIN_DATA_POINTS_FOR_ML=30
LOW_DATA_THRESHOLD=14

# ---- Celery ----
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2